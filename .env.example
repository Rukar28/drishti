# VisionMate v2 — Environment Configuration Example
# Copy this file to .env and adjust values before starting the server.
# .env is gitignored — never commit real secrets.

# ── Camera Source ──────────────────────────────────────────────
# Primary production camera: 'esp32' (ESP32-CAM /capture snapshot endpoint)
# Demo laptop: CAMERA_SOURCE=webcam  TOF_SOURCE=mock  GPS_SOURCE=mock
CAMERA_SOURCE=esp32
TOF_SOURCE=mock
GPS_SOURCE=mock

# ── Voice / ASR ────────────────────────────────────────────────
ASR_MODEL=tiny.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
VOICE_LISTENER_ENABLED=true

# ── Wake word (LOCAL / OFFLINE keyword spotting) ───────────────
# WAKE_WORD_MODE: auto | openwakeword | keyboard | disabled
#   auto         -> local openWakeWord engine if installed, else DEV FALLBACK
#   keyboard     -> DEVELOPMENT FALLBACK (Enter / push-to-talk). NOT a real wake word.
#   disabled     -> session gate always open (demo/tests)
# The real engine never sends audio to the cloud.
WAKE_WORD_ENABLED=true
WAKE_WORD_MODE=auto
WAKE_WORD_PHRASE=hey drishti
WAKE_WORD_MODEL_PATH=
WAKE_WORD_PRETRAINED=alexa
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_ACK_TEXT=

# ── ESP32-CAM SoftAP Settings ──────────────────────────────────
# Fixed SoftAP IP — never changes between sessions (no DHCP dependency).
ESP32_AP_IP=192.168.4.1
ESP32_STREAM_URL=http://192.168.4.1:81/stream
ESP32_CAPTURE_URL=http://192.168.4.1/capture
ESP32_INFO_URL=http://192.168.4.1/info
ESP32_MDNS_HOST=visionmatecam.local
ESP32_CONNECT_TIMEOUT_SEC=5.0
ESP32_RECONNECT_MAX_DELAY_SEC=8.0
ESP32_READ_CHUNK_BYTES=8192

# ── Processing ─────────────────────────────────────────────────
VISIONMATE_TARGET_FPS=18
DETECTION_DEVICE=cuda

# ── Reasoning ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=moondream

# ── Depth / ToF (VL53L5CX via companion MCU JSON endpoint) ─────
# Leave blank on laptop dev; the mock provider stays DEMO MODE.
# The VL53L5CX path is IMPLEMENTED but HARDWARE-UNVERIFIED until a sensor is attached.
TOF_ENDPOINT_URL=
TOF_TIMEOUT_SEC=1.0
TOF_CENTER_NEAR_THRESHOLD_MM=800

# ── Currency / Medicine (ON-DEMAND only) ───────────────────────
CURRENCY_DEFAULT_REGION=INR

# ── GPS / Navigation (backend-side protected config) ───────────
# NAVIGATION_PROVIDER: mock | google
NAVIGATION_PROVIDER=mock
NAVIGATION_DESTINATIONS=home:12.9716,77.5946;office:12.9352,77.6245;pharmacy:12.9600,77.6100
NAVIGATION_ARRIVAL_RADIUS_M=12.0
# Google Directions API key — backend only. NEVER hard-code or expose to the frontend.
GOOGLE_MAPS_API_KEY=

# ── SOS / Emergency Notifications ─────────────────────────────────
# Emergency alert system via email. Disabled by default.
SOS_ENABLED=false
SOS_COOLDOWN_SEC=60
SOS_RECIPIENT=
SOS_SMTP_HOST=
SOS_SMTP_PORT=587
SOS_SMTP_USERNAME=
SOS_SMTP_PASSWORD=
SOS_FROM_EMAIL=
# Google live navigation: enable Geocoding API, Routes API and Maps Static API
# on the backend key's Google project, with billing and server key restrictions.
# Then set NAVIGATION_PROVIDER=google and GPS_SOURCE=browser.
# Browser GPS needs localhost or HTTPS and explicit browser permission.
