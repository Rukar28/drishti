# VisionMate v2 — Environment Configuration Example
# Copy this file to .env and adjust values before starting the server.
# .env is gitignored — never commit real secrets.

# ── Camera Source ──────────────────────────────────────────────
# Primary production camera: 'esp32' (ESP32-CAM /capture snapshot endpoint)
CAMERA_SOURCE=esp32

# ── ESP32-CAM SoftAP Settings ──────────────────────────────────
# Fixed SoftAP IP — never changes between sessions (no DHCP dependency).
ESP32_AP_IP=192.168.4.1
ESP32_STREAM_URL=http://192.168.4.1:81/stream
ESP32_CAPTURE_URL=http://192.168.4.1/capture
ESP32_INFO_URL=http://192.168.4.1/info
ESP32_MDNS_HOST=visionmatecam.local
ESP32_CONNECT_TIMEOUT_SEC=5.0
ESP32_RECONNECT_MAX_DELAY_SEC=8.0
ESP32_READ_CHUNK_BYTES=8192

# ── Processing ─────────────────────────────────────────────────
VISIONMATE_TARGET_FPS=18
DETECTION_DEVICE=cuda

# ── Reasoning ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=moondream
